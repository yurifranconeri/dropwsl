# -- dropwsl:streamlit-auth --
# Cookie HMAC key for session signing. MUST be changed before running.
# Generate with: python -m {{PKG_PREFIX}}users gen-cookie-key
AUTH_COOKIE_KEY=change-me-run-gen-cookie-key
AUTH_COOKIE_NAME=app_auth
AUTH_COOKIE_EXPIRY_DAYS=30
AUTH_CREDENTIALS_PATH=users_data/credentials.yaml
AUTH_MAX_LOGIN_ATTEMPTS=5
